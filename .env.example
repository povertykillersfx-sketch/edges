VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only. In Vercel, name this open_ai and link it to the edges project.
# Do not prefix it with VITE_, or the key would ship in the browser.
open_ai=

# Optional. Only if the broker server's Swagger Value box is set.
# Name it mt5_api or API_TOKEN on Vercel. Do not prefix it with VITE_.
mt5_api=

# ---------------------------------------------------------------------------
# SwagStack Studio (optional until you enable /studio)
# Apply supabase/swagstack_schema.sql in the Supabase SQL editor first.
# ---------------------------------------------------------------------------

# Public PayFast fields (never put the passphrase in VITE_*)
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=
VITE_PAYFAST_SANDBOX=true
VITE_PAYFAST_PASS_CONFIGURED=false

# Server-only PayFast secrets (Vercel env, no VITE_ prefix)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Stripe (public publishable key may use VITE_; secret must stay server-only)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: email that becomes super_admin on first signup via DB setting
# set_config in SQL: select set_config('app.ss_bootstrap_admin_email', 'you@example.com', false);

