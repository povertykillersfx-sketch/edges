VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only. In Vercel, name this open_ai and link it to the edges project.
# Do not prefix it with VITE_, or the key would ship in the browser.
open_ai=

# Server only. Bearer token from the broker server's API_TOKEN.
# On Vercel, name it mt5_api or API_TOKEN and link it to the edges project.
# Do not prefix it with VITE_.
mt5_api=
