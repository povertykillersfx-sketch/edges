{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scan.js": {
      "maxDuration": 30
    },
    "api/brokers.js": {
      "maxDuration": 15
    },
    "api/mt5.js": {
      "maxDuration": 60
    },
    "api/swagstack-payments.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
