{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scan.js": {
      "maxDuration": 30
    },
    "api/brokers.js": {
      "maxDuration": 15
    },
    "api/mt5.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/ea-control",
      "destination": "/ea-control/index.html"
    },
    {
      "source": "/ea-control/",
      "destination": "/ea-control/index.html"
    },
    {
      "source": "/ea-control/portal",
      "destination": "/ea-control/portal/index.html"
    },
    {
      "source": "/ea-control/portal/",
      "destination": "/ea-control/portal/index.html"
    },
    {
      "source": "/ea-control/portal/dashboard",
      "destination": "/ea-control/portal/dashboard/index.html"
    },
    {
      "source": "/ea-control/portal/dashboard/",
      "destination": "/ea-control/portal/dashboard/index.html"
    },
    {
      "source": "/((?!api/|ea-control/).*)",
      "destination": "/index.html"
    }
  ]
}
